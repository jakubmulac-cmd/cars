# Soukromé soubory a databáze. Tento adresář nepatří do Gitu.
FLEET_DATA_DIR=.local
# Pro místní vývoj. Při nasazení za HTTPS nastavte 1.
FLEET_SECURE_COOKIES=0
FLEET_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Přihlášení a běžné stránky mohou zůstat na stejném originu.
# Pro vzdálené nasazení je nutné FLEET_SECURE_COOKIES=1 a HTTPS.
